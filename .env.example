# Copy this file to .env (or doctor.env) and fill in your real values.
# NEVER commit the filled-in file - .gitignore already blocks it.

# --- MongoDB Atlas -------------------------------------------------------
# Use a least-privilege database user (readWriteOnly on the target database).
# Generate the connection string in Atlas and paste it into your .env or
# Render/Vercel env variables instead of committing it to source.
# Example (replace with your real connection string):
# MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/doctorBot?retryWrites=true&w=majority
MONGODB_URI=<mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/DATABASE?retryWrites=true&w=majority>

# --- Server --------------------------------------------------------------
PORT=5000
# auto | mongo | file | memory
#   auto   -> MongoDB if MONGODB_URI connects, else file-backed (no Atlas needed)
#   mongo  -> require MongoDB, exit if it cannot connect
#   file   -> always persist to a JSON file on disk (DATA_FILE), survives restarts
#   memory -> no persistence (tests/demos only)
STORE=<auto|mongo|file|memory>

# Where the file-backed store keeps its JSON (only used when STORE=file, or when
# STORE=auto and no MONGODB_URI is set). Defaults to ./.data/store.json
DATA_FILE=.data/store.json

# --- Dashboard login (REQUIRED) ------------------------------------------
# Generate a long random string, e.g. in PowerShell:
#   [Convert]::ToBase64String((1..48|%{Get-Random -Max 256}))
JWT_SECRET=<your-64-char-random-secret>
# The first admin account is created automatically on first boot.
# Override in production ONLY via your environment variable / secret manager.
# NEVER store the real password in source code or .env.example.
ADMIN_EMAIL=<admin@example.com>
ADMIN_PASSWORD=<set-via-environment--secret-manager>

# --- Twilio webhook security ---------------------------------------------
# true = reject any request that is not signed by Twilio (turn on before going live)
TWILIO_VALIDATE_SIGNATURE=<true|false>

# --- Twilio (WhatsApp notification to the clinic; optional) --------------
TWILIO_ACCOUNT_SID=<ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx>
TWILIO_AUTH_TOKEN=<your_auth_token>
TWILIO_WHATSAPP_FROM=<whatsapp:+14155238886>
CLINIC_WHATSAPP_TO=<whatsapp:+919760849372>

# --- Booking rules -------------------------------------------------------
# 0 = unlimited appointments per time slot, 1 = only one patient per slot
MAX_PER_SLOT=0

# true = read the appointment back and wait for "haan/sahi" before saving.
# false = book the instant every detail is collected (no read-back).
CONFIRM_BEFORE_BOOKING=true